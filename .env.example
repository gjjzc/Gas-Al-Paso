# Copiar a .env y completar localmente. No guardar secretos en el repositorio.
# Usuario root: solo inicializa MongoDB, nunca se entrega a la API.
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=

# Usuario de aplicación: readWrite exclusivamente sobre gas_al_paso.
MONGO_APP_USER=
MONGO_APP_PASSWORD=
REDIS_PASSWORD=

# ADMIN inicial: se crea al arrancar solo si no existe ninguno. Clave de al menos 8 caracteres y hasta 72 bytes.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Firma JWT: generar un secreto aleatorio de al menos 32 bytes.
JWT_SECRET=

# Opcional; vacío usa el puerto 27017 definido en Compose.
MONGO_HOST_PORT=

# Opcionales: vacíos usan ADMIN_EMAIL y ADMIN_PASSWORD al ejecutar las suites.
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
