# Copiar a .env y completar localmente. No usar contraseñas reales aquí.
ORACLE_PASSWORD=
APP_USER=gas_app
APP_USER_PASSWORD=
MONGO_INITDB_ROOT_USERNAME=gas_admin
MONGO_INITDB_ROOT_PASSWORD=

# Puertos externos; si estan ocupados usar por ejemplo 1523 y 27018.
ORACLE_HOST_PORT=1522
MONGO_HOST_PORT=27017

# Firma JWT: generar un secreto aleatorio de al menos 32 bytes.
JWT_SECRET=
