# Ejemplos para VS Code con la extension REST Client.
# Ejecutar primero los login y la creacion del producto/usuario para obtener sus IDs.
# Solo datos y contrasenas ficticias de desarrollo. JWT_SECRET nunca se envia al cliente.
@base = http://localhost:4000/api
@tokenAdmin = {{loginAdmin.response.body.$.token}}
@tokenCliente = {{loginCliente.response.body.$.token}}
@tokenRepartidor = {{loginRepartidor.response.body.$.token}}
@idProducto = {{crearProducto.response.body.$.id_producto}}
@idUsuario = {{crearUsuario.response.body.$.id_usuario}}
@idEmpleado = {{crearUsuario.response.body.$.id_empleado}}

### Salud publica: HTTP 200 si ambas bases responden
GET {{base}}/health

### Login ADMIN
# @name loginAdmin
POST {{base}}/auth/login
Content-Type: application/json

{"email":"admin@demo.gasalpaso.test","password":"GasPasoDemo2026!"}

### Login CLIENTE
# @name loginCliente
POST {{base}}/auth/login
Content-Type: application/json

{"email":"ana@demo.gasalpaso.test","password":"GasPasoDemo2026!"}

### Login REPARTIDOR
# @name loginRepartidor
POST {{base}}/auth/login
Content-Type: application/json

{"email":"camila@demo.gasalpaso.test","password":"GasPasoDemo2026!"}

### Usuario autenticado (funciona con cualquiera de los tres tokens)
GET {{base}}/auth/me
Authorization: Bearer {{tokenCliente}}

### Registro publico: solo CLIENTE; usar otro email si ya existe
POST {{base}}/auth/registro
Content-Type: application/json

{
  "nombre":"Cliente de ejemplo",
  "email":"nuevo-cliente@demo.gasalpaso.test",
  "password":"ClaveClienteDemo2026!",
  "telefono":"+56900000999",
  "direccion_principal":"Calle Ejemplo 999",
  "id_comuna":1
}

### Catalogo publico: precio y stock actuales desde Oracle
GET {{base}}/catalogo?limite=20&offset=0

### Filtrar categoria GAS o ACCESORIO
GET {{base}}/catalogo?categoria=GAS

### Detalle publico
GET {{base}}/catalogo/1

### Incluir bajas: requiere ADMIN
GET {{base}}/catalogo?incluir_inactivos=true
Authorization: Bearer {{tokenAdmin}}

### Crear producto: ADMIN, HTTP 201. Se genera id_producto en Oracle.
# @name crearProducto
POST {{base}}/catalogo
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{
  "nombre":"Gas 5kg demostracion API",
  "descripcion":"Producto ficticio para probar el CRUD",
  "categoria":"GAS",
  "peso":5,
  "precio":8500,
  "stock":20,
  "atributos":{"peso_kg":5,"demo":true},
  "destacado":false,
  "activo":true
}

### Editar producto: ADMIN, PUT acepta campos parciales
PUT {{base}}/catalogo/{{idProducto}}
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{"nombre":"Gas 5kg editado","precio":9000,"stock":18,"destacado":true}

### Editar solo precio/stock/activo de Oracle: ADMIN
PATCH {{base}}/productos/{{idProducto}}
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{"precio":9500,"stock":16,"activo":true}

### Baja logica: ADMIN. Conserva detalle de ventas y auditoria.
DELETE {{base}}/catalogo/{{idProducto}}
Authorization: Bearer {{tokenAdmin}}

### Ver producto dado de baja: ADMIN
GET {{base}}/catalogo/{{idProducto}}?incluir_inactivos=true
Authorization: Bearer {{tokenAdmin}}

### Reactivar producto
PATCH {{base}}/productos/{{idProducto}}
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{"activo":true}

### Comunas publicas
GET {{base}}/comunas

### Usuarios: ADMIN, nunca devuelve password_hash ni token_version
GET {{base}}/usuarios?limite=50&offset=0
Authorization: Bearer {{tokenAdmin}}

### Crear repartidor: ADMIN. Tambien admite ADMIN o CLIENTE.
# @name crearUsuario
POST {{base}}/usuarios
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{
  "email":"repartidor-nuevo@demo.gasalpaso.test",
  "password":"ClaveRepartidorDemo2026!",
  "nombre":"Repartidor de ejemplo",
  "rol":"REPARTIDOR",
  "activo":true,
  "comunas":[1,2]
}

### Editar usuario: ADMIN
PATCH {{base}}/usuarios/{{idUsuario}}
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{"nombre":"Repartidor editado","email":"repartidor-editado@demo.gasalpaso.test"}

### Desactivar usuario: revoca sesiones existentes
PATCH {{base}}/usuarios/{{idUsuario}}
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{"activo":false}

### Reactivar para poder cambiar su cobertura
PATCH {{base}}/usuarios/{{idUsuario}}
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{"activo":true}

### Repartidores activos: los que cubren comuna=1 aparecen primero
GET {{base}}/repartidores?comuna=1
Authorization: Bearer {{tokenAdmin}}

### Reemplazar cobertura de un repartidor (id de EMPLEADO, no de usuario)
PUT {{base}}/repartidores/{{idEmpleado}}/comunas
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{"comunas":[1,3,7]}

### Ver auditoria de cambios de precio: ADMIN
GET {{base}}/auditoria?tipo=CAMBIO_PRECIO&limite=50
Authorization: Bearer {{tokenAdmin}}

### Ver auditoria de cambios de stock
GET {{base}}/auditoria?tipo=CAMBIO_STOCK
Authorization: Bearer {{tokenAdmin}}

### Reintento de pendientes Oracle -> Mongo: ADMIN (tambien automatico cada 5 segundos)
POST {{base}}/sincronizacion/reintentar
Authorization: Bearer {{tokenAdmin}}

### Prueba de permisos: CLIENTE debe recibir HTTP 403
POST {{base}}/catalogo
Authorization: Bearer {{tokenCliente}}
Content-Type: application/json

{}

### Prueba de token: debe devolver HTTP 401
GET {{base}}/auth/me

### Prueba de validacion: ADMIN debe recibir HTTP 400
PATCH {{base}}/productos/1
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{"stock":-1}

# ================================================================
# FASE 3: carrito, pedidos y ventas. Usar claves nuevas para cada venta
# NUEVA; repetir la misma clave/cuerpo solo para reintentar la misma venta.
# Primero ejecutar loginAdmin, loginCliente y loginRepartidor de arriba.
# ================================================================
@pedidoWeb = {{crearPedidoWeb.response.body.$._id}}
@pedidoLlamada = {{crearPedidoLlamada.response.body.$._id}}
@claveWeb = f3-web-demo-001
@claveTelefono = f3-telefono-demo-001
@claveTarreo = f3-tarreo-demo-001

### Leer carrito propio (CLIENTE). GET no renueva el TTL.
GET {{base}}/carrito
Authorization: Bearer {{tokenCliente}}

### Vaciar carrito propio antes de la demostracion
DELETE {{base}}/carrito
Authorization: Bearer {{tokenCliente}}

### Agregar 2 balones de 11 kg: $30.000, descuento $3.000 si mantienen el precio demo
POST {{base}}/carrito/items
Authorization: Bearer {{tokenCliente}}
Content-Type: application/json

{"id_producto":2,"cantidad":2}

### Cambiar cantidad (sustituye, no suma). Cada cambio renueva 30 minutos.
PATCH {{base}}/carrito/items/2
Authorization: Bearer {{tokenCliente}}
Content-Type: application/json

{"cantidad":2}

### Quitar una linea; volver a agregarla antes de confirmar si ejecutas este ejemplo
DELETE {{base}}/carrito/items/2
Authorization: Bearer {{tokenCliente}}

### Confirmar WEB: ejecutar despues de agregar los productos al carrito
# @name crearPedidoWeb
POST {{base}}/pedidos
Authorization: Bearer {{tokenCliente}}
Idempotency-Key: {{claveWeb}}
Content-Type: application/json

{
  "direccion_entrega":{"calle":"Calle Ejemplo","numero":"100","id_comuna":1,"referencia":"Direccion ficticia"},
  "metodo_cobro":"EFECTIVO"
}

### Reintento del mismo checkout: HTTP 200, mismo id_venta, sin nuevo descuento de stock
POST {{base}}/pedidos
Authorization: Bearer {{tokenCliente}}
Idempotency-Key: {{claveWeb}}
Content-Type: application/json

{
  "direccion_entrega":{"calle":"Calle Ejemplo","numero":"100","id_comuna":1,"referencia":"Direccion ficticia"},
  "metodo_cobro":"EFECTIVO"
}

### Pedidos del CLIENTE autenticado
GET {{base}}/pedidos/mios
Authorization: Bearer {{tokenCliente}}

### Pedidos ADMIN, filtros opcionales estado, fecha AAAA-MM-DD y comuna (nombre o ID)
GET {{base}}/pedidos?estado=RECIBIDO&comuna=1&limite=50&offset=0
Authorization: Bearer {{tokenAdmin}}

### Detalle: ADMIN, cliente propietario o repartidor asignado
GET {{base}}/pedidos/{{pedidoWeb}}
Authorization: Bearer {{tokenCliente}}

### Sugerencias: primero quienes cubren la comuna de entrega
GET {{base}}/repartidores?comuna=1
Authorization: Bearer {{tokenAdmin}}

### ADMIN asigna a Camila (id_empleado=2 de la semilla)
PATCH {{base}}/pedidos/{{pedidoWeb}}/asignar
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{"id_empleado":2}

### Pedidos asignados al REPARTIDOR autenticado
GET {{base}}/pedidos/asignados
Authorization: Bearer {{tokenRepartidor}}

### Repartidor asignado o ADMIN: ASIGNADO -> EN_CAMINO
PATCH {{base}}/pedidos/{{pedidoWeb}}/estado
Authorization: Bearer {{tokenRepartidor}}
Content-Type: application/json

{"estado":"EN_CAMINO"}

### EN_CAMINO -> ENTREGADO exige metodo real de pago y cobra la venta
PATCH {{base}}/pedidos/{{pedidoWeb}}/estado
Authorization: Bearer {{tokenRepartidor}}
Content-Type: application/json

{"estado":"ENTREGADO","metodo_pago":"EFECTIVO"}

### ADMIN crea pedido por llamada para un cliente existente; no usa su carrito
# @name crearPedidoLlamada
POST {{base}}/pedidos/telefonico
Authorization: Bearer {{tokenAdmin}}
Idempotency-Key: {{claveTelefono}}
Content-Type: application/json

{
  "id_cliente":1,
  "direccion_entrega":{"calle":"Calle Ejemplo","numero":"100","id_comuna":1,"referencia":"Pedido telefonico demo"},
  "metodo_cobro":"TRANSFERENCIA",
  "items":[{"id_producto":3,"cantidad":1},{"id_producto":5,"cantidad":1}]
}

### CLIENTE cancela su pedido telefonico mientras sigue RECIBIDO
PATCH {{base}}/pedidos/{{pedidoLlamada}}/cancelar
Authorization: Bearer {{tokenCliente}}

### ADMIN puede cancelar hasta EN_CAMINO; repetir CANCELADO no devuelve doble stock
PATCH {{base}}/pedidos/{{pedidoLlamada}}/cancelar
Authorization: Bearer {{tokenAdmin}}

### ADMIN elimina documento Mongo solo si esta CANCELADO; conserva Oracle y auditoria
DELETE {{base}}/pedidos/{{pedidoLlamada}}
Authorization: Bearer {{tokenAdmin}}

### TARREO: REPARTIDOR, cobrada desde el alta, sin cliente ni direccion de pedido
POST {{base}}/ventas/calle
Authorization: Bearer {{tokenRepartidor}}
Idempotency-Key: {{claveTarreo}}
Content-Type: application/json

{"items":[{"id_producto":2,"cantidad":1},{"id_producto":3,"cantidad":1}],"metodo_pago":"EFECTIVO"}

### Ventas del dia del repartidor y resumen de COBRADAS separado por metodo
GET {{base}}/ventas/dia
Authorization: Bearer {{tokenRepartidor}}

### ADMIN filtra por empleado, canal y estado de pago; fecha es opcional AAAA-MM-DD
GET {{base}}/ventas/dia?id_empleado=2&canal=TARREO&estado_pago=COBRADA
Authorization: Bearer {{tokenAdmin}}

### Comprobantes Mongo del tarreo y sus totales (ADMIN)
GET {{base}}/auditoria?tipo=VENTA_TARREO
Authorization: Bearer {{tokenAdmin}}

### Stock insuficiente: HTTP 409 y evento VENTA_RECHAZADA_STOCK
POST {{base}}/ventas/calle
Authorization: Bearer {{tokenRepartidor}}
Idempotency-Key: f3-sin-stock-demo-001
Content-Type: application/json

{"items":[{"id_producto":4,"cantidad":9999}],"metodo_pago":"EFECTIVO"}

### Consultar rechazos por stock
GET {{base}}/auditoria?tipo=VENTA_RECHAZADA_STOCK
Authorization: Bearer {{tokenAdmin}}

# ================================================================
# FASE 4: control diario. Crear un repartidor nuevo para la demostracion:
# los cierres son finales y las cuentas demo pueden tener pedidos pendientes.
# ================================================================
@idRepControl = {{crearRepControl.response.body.$.id_empleado}}
@tokenControl = {{loginControl.response.body.$.token}}

### ADMIN crea un repartidor de prueba (cambiar email en una nueva demostracion)
# @name crearRepControl
POST {{base}}/usuarios
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{"nombre":"Control diario demo","email":"control-diario@demo.gasalpaso.test","password":"ClaveControlDemo2026!","rol":"REPARTIDOR","comunas":[1]}

### Login del repartidor nuevo
# @name loginControl
POST {{base}}/auth/login
Content-Type: application/json

{"email":"control-diario@demo.gasalpaso.test","password":"ClaveControlDemo2026!"}

### ADMIN registra 3 balones. Carga de control: no modifica Productos.stock.
POST {{base}}/cargas
Authorization: Bearer {{tokenAdmin}}
Idempotency-Key: f4-carga-demo-001
Content-Type: application/json

{"id_empleado":{{idRepControl}},"items":[{"id_producto":2,"cantidad_cargada":3}]}

### ADMIN suma una recarga: quedan 4. Reintentar esta clave no vuelve a sumar.
POST {{base}}/cargas
Authorization: Bearer {{tokenAdmin}}
Idempotency-Key: f4-recarga-demo-001
Content-Type: application/json

{"id_empleado":{{idRepControl}},"items":[{"id_producto":2,"cantidad_cargada":1}]}

### Cargas de hoy; tambien admite fecha=AAAA-MM-DD
GET {{base}}/cargas?id_empleado={{idRepControl}}
Authorization: Bearer {{tokenAdmin}}

### Venta de 2 balones de 11 kg: con precio demo total $27.000 tras descuento
POST {{base}}/ventas/calle
Authorization: Bearer {{tokenControl}}
Idempotency-Key: f4-venta-demo-001
Content-Type: application/json

{"items":[{"id_producto":2,"cantidad":2}],"metodo_pago":"EFECTIVO"}

### Cuadratura antes de cerrar: ABIERTO, esperado calculado en Oracle
GET {{base}}/cuadratura?id_empleado={{idRepControl}}
Authorization: Bearer {{tokenAdmin}}

### Cierre equilibrado: con precio demo 4 cargados = 2 vendidos + 2 devueltos
# Usar los importes esperados del reporte anterior si se cambiaron los precios.
POST {{base}}/cierre
Authorization: Bearer {{tokenControl}}
Idempotency-Key: f4-cierre-demo-001
Content-Type: application/json

{"entregado_efectivo":27000,"entregado_transferencia":0,"devueltos":[{"id_producto":2,"devuelto":2}],"observacion":"Todo cuadra"}

### Resultado: CUADRADO, dinero y balones con diferencia cero
GET {{base}}/cuadratura?id_empleado={{idRepControl}}
Authorization: Bearer {{tokenAdmin}}

### Reporte general; fecha opcional corresponde a fecha de cobro
GET {{base}}/cuadratura
Authorization: Bearer {{tokenAdmin}}

### Auditoria de cierres (ADMIN); tambien admite fecha e id_usuario
GET {{base}}/auditoria?tipo=CIERRE_CAJA&id_empleado={{idRepControl}}
Authorization: Bearer {{tokenAdmin}}

### Auditoria de recargas
GET {{base}}/auditoria?tipo=CARGA_DIARIA&id_empleado={{idRepControl}}
Authorization: Bearer {{tokenAdmin}}

# Para demostrar DESCUADRE, usar OTRO repartidor sin cerrar:
# - Mismo movimiento, entregar efectivo 26000 en vez de 27000 => diferencia -1000.
# - Entregar 27000 pero devolver 1 en vez de 2 balones => diferencia de balones -1.
# No se puede modificar un cierre ya guardado con otro POST.

# ================================================================
# FASE 6: vista privada del cierre del REPARTIDOR (antes o despues del POST).
# No acepta id_empleado; siempre usa el empleado del JWT autenticado.
# ================================================================

### Preparar/consultar mi cierre de hoy: dinero esperado, cargas y pedidos pendientes
GET {{base}}/cierre
Authorization: Bearer {{tokenRepartidor}}

### Consultar mi cierre de otra fecha; cambiar la fecha segun los datos locales
GET {{base}}/cierre?fecha=2026-11-06
Authorization: Bearer {{tokenRepartidor}}

### Consulta ajena rechazada: HTTP 400, sin exponer otros empleados
GET {{base}}/cierre?id_empleado=1
Authorization: Bearer {{tokenRepartidor}}

### El ADMIN sigue usando /cuadratura: GET /cierre requiere REPARTIDOR (HTTP 403)
GET {{base}}/cierre
Authorization: Bearer {{tokenAdmin}}

# ================================================================
# FASE 7: busquedas antes de paginar para los selectores del ADMIN.
# ================================================================

### Clientes activos por nombre/email
GET {{base}}/usuarios?rol=CLIENTE&activo=true&buscar=ana&limite=15&offset=0
Authorization: Bearer {{tokenAdmin}}

### Buscar productos por nombre/descripcion e incluir inactivos (ADMIN)
GET {{base}}/catalogo?incluir_inactivos=true&buscar=gas&limite=15&offset=0
Authorization: Bearer {{tokenAdmin}}

### Cuadratura incluye productos_vendidos: gases y accesorios por trabajador
GET {{base}}/cuadratura
Authorization: Bearer {{tokenAdmin}}
